(module
 (memory (export "memory") 32)
 (func $filter (export "filter") (param $src i32) (param $count i32) (param $dst i32)
  (param $ca f64) (param $sa f64) (param $ce f64) (param $se f64)
  (param $extent f64) (param $width f64) (param $height f64) (param $focal f64)
  (param $alpha f64) (param $cone f64) (param $sphere f64) (param $fog f64) (param $threshold f64) (result i32)
  (local $i i32) (local $n i32) (local $p i32) (local $out i32)
  (local $x f64) (local $y f64) (local $z f64) (local $xx f64) (local $yy f64) (local $depth f64)
  (local $forward f64) (local $perspective f64) (local $px f64) (local $py f64) (local $d f64) (local $b f64)
  (block $end (loop $loop
   (br_if $end (i32.ge_u (local.get $i) (local.get $count)))
   (local.set $p (i32.add (local.get $src) (i32.mul (local.get $i) (i32.const 56))))
   (block $skip
    (local.set $b (f64.load offset=40 (local.get $p)))
    (br_if $skip (f64.lt (f64.mul (local.get $alpha) (local.get $b)) (f64.const 0.003)))
    (local.set $x (f64.load (local.get $p))) (local.set $y (f64.load offset=8 (local.get $p))) (local.set $z (f64.load offset=16 (local.get $p)))
    (local.set $xx (f64.sub (f64.mul (local.get $x) (local.get $ca)) (f64.mul (local.get $y) (local.get $sa))))
    (local.set $yy (f64.add (f64.mul (local.get $x) (local.get $sa)) (f64.mul (local.get $y) (local.get $ca))))
    (local.set $depth (f64.add (f64.mul (local.get $yy) (local.get $ce)) (f64.mul (local.get $z) (local.get $se))))
    (local.set $forward (f64.add (f64.mul (local.get $extent) (f64.const 5)) (local.get $depth)))
    (br_if $skip (f64.le (local.get $forward) (f64.mul (local.get $extent) (f64.const 0.2))))
    (local.set $perspective (f64.div (local.get $focal) (local.get $forward)))
    (local.set $px (f64.add (f64.mul (local.get $width) (f64.const 0.5)) (f64.mul (local.get $xx) (local.get $perspective))))
    (local.set $py (f64.add (f64.mul (local.get $height) (f64.const 0.49)) (f64.mul (f64.sub (f64.mul (local.get $yy) (local.get $se)) (f64.mul (local.get $z) (local.get $ce))) (local.get $perspective))))
    (br_if $skip (i32.or (i32.or (f64.le (local.get $px) (f64.const -8)) (f64.ge (local.get $px) (f64.add (local.get $width) (f64.const 8)))) (i32.or (f64.le (local.get $py) (f64.const -8)) (f64.ge (local.get $py) (f64.add (local.get $height) (f64.const 8))))))
    (local.set $d (f64.load offset=24 (local.get $p)))
    (if (i32.eqz (i32.and (f64.lt (local.get $depth) (f64.const 0)) (f64.lt (f64.mul (f64.max (f64.const 0) (f64.sub (f64.mul (local.get $d) (local.get $d)) (f64.mul (local.get $depth) (local.get $depth)))) (local.get $cone)) (f64.mul (f64.mul (f64.mul (f64.const 0.81) (local.get $forward)) (local.get $forward)) (local.get $sphere)))))
     (then (br_if $skip (f64.gt (f64.mul (local.get $depth) (local.get $depth)) (f64.mul (local.get $fog) (f64.add (local.get $threshold) (f64.load offset=32 (local.get $p))))))))
    (local.set $out (i32.add (local.get $dst) (i32.mul (local.get $n) (i32.const 48))))
    (f64.store (local.get $out) (local.get $px)) (f64.store offset=8 (local.get $out) (local.get $py))
    (f64.store offset=16 (local.get $out) (local.get $depth)) (f64.store offset=24 (local.get $out) (local.get $d))
    (f64.store offset=32 (local.get $out) (local.get $b)) (f64.store offset=40 (local.get $out) (f64.load offset=48 (local.get $p)))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
   )
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)
  )) (local.get $n)
 )
 (func (export "filterMany") (param $list i32) (param $count i32) (param $dst i32) (param $ca f64) (param $sa f64) (param $ce f64) (param $se f64) (param $extent f64) (param $width f64) (param $height f64) (param $focal f64) (param $alpha f64) (param $cone f64) (param $sphere f64) (param $fog f64) (param $threshold f64) (result i32)
  (local $i i32) (local $n i32) (local $p i32)
