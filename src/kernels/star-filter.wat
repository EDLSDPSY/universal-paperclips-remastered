   (br_if $end (i32.ge_u (local.get $i) (local.get $count)))
   (local.set $p (i32.add (local.get $list) (i32.mul (local.get $i) (i32.const 8))))
   (local.set $n (i32.add (local.get $n) (call $filter (i32.load (local.get $p)) (i32.load offset=4 (local.get $p)) (i32.add (local.get $dst) (i32.mul (local.get $n) (i32.const 48))) (local.get $ca) (local.get $sa) (local.get $ce) (local.get $se) (local.get $extent) (local.get $width) (local.get $height) (local.get $focal) (local.get $alpha) (local.get $cone) (local.get $sphere) (local.get $fog) (local.get $threshold))))
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)
  )) (local.get $n)
 )

 (func (export "boxes") (param $src i32) (param $count i32) (param $dst i32) (param $ca f64) (param $sa f64) (param $ce f64) (param $se f64) (param $extent f64) (param $width f64) (param $height f64) (param $focal f64) (param $limit f64) (result i32)
 (local $i i32) (local $n i32) (local $p i32) (local $x f64) (local $y f64) (local $z f64) (local $hx f64) (local $hy f64) (local $hz f64) (local $pad f64) (local $eye f64) (local $depth f64) (local $reach f64) (local $far f64) (local $px f64) (local $py f64) (local $rx f64) (local $ry f64)
 (local.set $eye (f64.mul (local.get $extent) (f64.const 5)))
 (block $end (loop $loop (br_if $end (i32.ge_u (local.get $i) (local.get $count))) (local.set $p (i32.add (local.get $src) (i32.mul (local.get $i) (i32.const 28))))
(local.set $x (f64.promote_f32 (f32.load offset=0 (local.get $p))))
(local.set $y (f64.promote_f32 (f32.load offset=4 (local.get $p))))
(local.set $z (f64.promote_f32 (f32.load offset=8 (local.get $p))))
(local.set $hx (f64.promote_f32 (f32.load offset=12 (local.get $p))))
(local.set $hy (f64.promote_f32 (f32.load offset=16 (local.get $p))))
(local.set $hz (f64.promote_f32 (f32.load offset=20 (local.get $p))))
(local.set $pad (f64.promote_f32 (f32.load offset=24 (local.get $p))))
(local.set $pad (f64.mul (f64.add (local.get $pad) (local.get $extent)) (f64.const 0.04)))
(local.set $hx (f64.add (local.get $hx) (local.get $pad)))
(local.set $hy (f64.add (local.get $hy) (local.get $pad)))
(local.set $hz (f64.add (local.get $hz) (local.get $pad)))
(local.set $depth (f64.add (f64.mul (f64.add (f64.mul (local.get $x) (local.get $sa)) (f64.mul (local.get $y) (local.get $ca))) (local.get $ce)) (f64.mul (local.get $z) (local.get $se))))
(local.set $reach (f64.add (f64.add (f64.mul (f64.abs (f64.mul (local.get $sa) (local.get $ce))) (local.get $hx)) (f64.mul (f64.abs (f64.mul (local.get $ca) (local.get $ce))) (local.get $hy))) (f64.mul (f64.abs (local.get $se)) (local.get $hz))))
(block $skip (br_if $skip (f64.ge (f64.sub (local.get $depth) (local.get $reach)) (local.get $limit))) (br_if $skip (f64.lt (f64.add (local.get $depth) (local.get $reach)) (f64.mul (local.get $extent) (f64.const -4.8))))
(local.set $far (f64.add (local.get $eye) (f64.add (local.get $depth) (local.get $reach))))
(local.set $px (f64.sub (f64.mul (local.get $x) (local.get $ca)) (f64.mul (local.get $y) (local.get $sa))))
(local.set $rx (f64.add (f64.mul (f64.abs (local.get $ca)) (local.get $hx)) (f64.mul (f64.abs (local.get $sa)) (local.get $hy))))
(local.set $py (f64.sub (f64.mul (f64.add (f64.mul (local.get $x) (local.get $sa)) (f64.mul (local.get $y) (local.get $ca))) (local.get $se)) (f64.mul (local.get $z) (local.get $ce))))
(local.set $ry (f64.add (f64.add (f64.mul (f64.abs (f64.mul (local.get $sa) (local.get $se))) (local.get $hx)) (f64.mul (f64.abs (f64.mul (local.get $ca) (local.get $se))) (local.get $hy))) (f64.mul (f64.abs (local.get $ce)) (local.get $hz))))
(br_if $skip (f64.gt (f64.mul (f64.sub (f64.abs (local.get $px)) (local.get $rx)) (local.get $focal)) (f64.mul (f64.add (f64.mul (local.get $width) (f64.const 0.5)) (f64.const 2)) (local.get $far))))
(br_if $skip (f64.gt (f64.mul (f64.sub (f64.abs (local.get $py)) (local.get $ry)) (local.get $focal)) (f64.mul (f64.add (f64.mul (local.get $height) (f64.const 0.51)) (f64.const 2)) (local.get $far))))
(i32.store (i32.add (local.get $dst) (i32.mul (local.get $n) (i32.const 4))) (local.get $i)) (local.set $n (i32.add (local.get $n) (i32.const 1))) ) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop))) (local.get $n))
 (func (export "gather") (param $selected i32) (param $count i32) (param $offsets i32) (param $ids i32) (param $mask i32) (param $dst i32) (param $total i32) (result i32)
 (local $i i32) (local $j i32) (local $end i32) (local $p i32) (local $id i32) (local $word i32) (local $bits i32) (local $n i32)
 (memory.fill (local.get $mask) (i32.const 0) (i32.mul (local.get $total) (i32.const 4)))
 (block $done (loop $cells (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
 (local.set $p (i32.add (local.get $offsets) (i32.mul (i32.load (i32.add (local.get $selected) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 8))))
 (local.set $j (i32.load (local.get $p))) (local.set $end (i32.add (local.get $j) (i32.load offset=4 (local.get $p))))
 (block $next (loop $idsLoop (br_if $next (i32.ge_u (local.get $j) (local.get $end)))
 (local.set $id (i32.load (i32.add (local.get $ids) (i32.mul (local.get $j) (i32.const 4)))))
 (local.set $p (i32.add (local.get $mask) (i32.mul (i32.shr_u (local.get $id) (i32.const 5)) (i32.const 4))))
 (i32.store (local.get $p) (i32.or (i32.load (local.get $p)) (i32.shl (i32.const 1) (i32.and (local.get $id) (i32.const 31)))))
 (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $idsLoop)))
 (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $cells)))
 (local.set $i (i32.const 0))
 (block $doneWords (loop $words (br_if $doneWords (i32.ge_u (local.get $i) (local.get $total)))
 (local.set $bits (i32.load (i32.add (local.get $mask) (i32.mul (local.get $i) (i32.const 4)))))
 (block $nextWord (loop $bitsLoop (br_if $nextWord (i32.eqz (local.get $bits)))
 (i32.store (i32.add (local.get $dst) (i32.mul (local.get $n) (i32.const 4))) (i32.add (i32.mul (local.get $i) (i32.const 32)) (i32.ctz (local.get $bits))))
 (local.set $n (i32.add (local.get $n) (i32.const 1))) (local.set $bits (i32.and (local.get $bits) (i32.sub (local.get $bits) (i32.const 1)))) (br $bitsLoop)))
 (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $words))) (local.get $n))
)
