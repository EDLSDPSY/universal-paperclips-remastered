     (local.set $count (i32.add (local.get $count) (i32.shr_u (i32.popcnt (local.get $mask)) (i32.const 2))))
     (local.set $tile (i32.add (i32.mul (i32.shr_u (local.get $y) (i32.const 3)) (local.get $tilesX)) (i32.shr_u (local.get $x) (i32.const 3))))
     (i32.store8 (i32.add (local.get $dirty) (local.get $tile)) (i32.const 1))
     (i32.store8 (i32.add (local.get $dirty) (i32.add (i32.mul (i32.shr_u (local.get $y) (i32.const 3)) (local.get $tilesX)) (i32.shr_u (i32.add (local.get $x) (i32.const 3)) (i32.const 3)))) (i32.const 1))))
    (local.set $x (i32.add (local.get $x) (i32.const 4))) (br $vector)))
   (block $endTail (loop $tail
    (br_if $endTail (i32.ge_u (local.get $x) (local.get $x1)))
    (local.set $at (i32.mul (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 4)))
    (local.set $value (i32.load (i32.add (local.get $source) (local.get $at))))
    (if (i32.or (local.get $first) (i32.ne (local.get $value) (i32.load (i32.add (local.get $previous) (local.get $at))))) (then
     (i32.store (i32.add (local.get $previous) (local.get $at)) (local.get $value))
