   (br_if $endY (i32.ge_u (local.get $y) (local.get $y1)))
   (local.set $x (local.get $x0))
   (block $endX (loop $column
    (br_if $endX (i32.ge_u (local.get $x) (local.get $x1)))
    (local.set $i (i32.mul (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 4)))
    (local.set $j (i32.add (local.get $source) (i32.load (i32.add (local.get $indices) (local.get $i)))))
    (local.set $fx (f32x4.splat (f32.load (i32.add (local.get $weightsX) (local.get $i)))))
