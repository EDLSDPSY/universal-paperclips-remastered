  (loop $tiles
   (if (i32.load8_u (i32.add (local.get $mask) (local.get $t))) (then
    (local.set $x (i32.mul (i32.rem_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (local.set $y (i32.mul (i32.div_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (i32.store8 (i32.add (local.get $changed) (local.get $t)) (i32.or (local.get $force) (call $warp (local.get $source) (local.get $out) (local.get $indices) (local.get $weightsX) (local.get $weightsY) (local.get $stride) (local.get $width)  (local.get $x) (call $tileEnd (i32.add (local.get $x) (i32.const 8)) (local.get $width)) (local.get $y) (call $tileEnd (i32.add (local.get $y) (i32.const 8)) (local.get $height)))))
