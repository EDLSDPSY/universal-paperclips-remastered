 (func (export "diff")
  (param $source i32) (param $previous i32) (param $dirty i32) (param $tilesX i32) (param $width i32)
  (param $x0 i32) (param $x1 i32) (param $y0 i32) (param $y1 i32) (param $first i32) (result i32)
  (local $x i32) (local $y i32) (local $at i32) (local $tile i32) (local $mask i32) (local $count i32) (local $pixels v128) (local $value i32)
  (local.set $y (local.get $y0))
  (block $endY (loop $row
   (br_if $endY (i32.ge_u (local.get $y) (local.get $y1)))
   (local.set $x (local.get $x0))
   (block $endVector (loop $vector
    (br_if $endVector (i32.gt_u (i32.add (local.get $x) (i32.const 4)) (local.get $x1)))
    (local.set $at (i32.mul (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 4)))
    (local.set $pixels (v128.load (i32.add (local.get $source) (local.get $at))))
