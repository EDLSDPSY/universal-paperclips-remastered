    ) (else (call $halo (local.get $out) (local.get $warp) (local.get $wide) (local.get $core) (local.get $width) (local.get $bloom) (local.get $x) (call $tileEnd (i32.add (local.get $x) (i32.const 8)) (local.get $width)) (local.get $y) (call $tileEnd (i32.add (local.get $y) (i32.const 8)) (local.get $height)))))
   ))
   (local.set $t (i32.add (local.get $t) (i32.const 1)))
   (br_if $tiles (i32.lt_u (local.get $t) (local.get $count)))
  )
 )
 (func (export "warpTiles")
  (param $source i32) (param $out i32) (param $indices i32) (param $weightsX i32) (param $weightsY i32) (param $stride i32)
   (param $mask i32) (param $changed i32) (param $width i32) (param $height i32) (param $force i32)
  (local $t i32) (local $cols i32) (local $count i32) (local $x i32) (local $y i32)
