 (func $warp (export "warp")
  (param $source i32) (param $out i32) (param $indices i32) (param $weightsX i32) (param $weightsY i32)
  (param $stride i32) (param $width i32) (param $x0 i32) (param $x1 i32) (param $y0 i32) (param $y1 i32) (result i32)
  (local $x i32) (local $y i32) (local $i i32) (local $j i32) (local $a v128) (local $b v128) (local $fx v128) (local $fy v128)
  (local $packed i32) (local $changed i32)
  (local.set $y (local.get $y0))
