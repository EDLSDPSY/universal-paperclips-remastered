   (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $row)))
  (i32.ne (local.get $changed) (i32.const 0))
 )
 (func $gather (param $p i32) (param $r i32) (param $g i32) (param $b i32) (param $offset i32) (result v128)
  (f32x4.convert_i32x4_u (i32x4.extend_low_i16x8_u (i16x8.extend_low_i8x16_u
   (v128.load8_lane 2 (i32.add (i32.add (local.get $p) (local.get $b)) (local.get $offset))
    (v128.load8_lane 1 (i32.add (i32.add (local.get $p) (local.get $g)) (local.get $offset))
     (v128.load8_lane 0 (i32.add (i32.add (local.get $p) (local.get $r)) (local.get $offset)) (v128.const i32x4 0 0 0 0))))))))
 (func $bilinear3 (param $p i32) (param $r i32) (param $g i32) (param $b i32) (param $fx v128) (param $fy v128) (param $stride i32) (result v128)
  (local $a v128) (local $c v128)
  (local.set $a (call $gather (local.get $p) (local.get $r) (local.get $g) (local.get $b) (i32.const 0)))
  (local.set $c (call $gather (local.get $p) (local.get $r) (local.get $g) (local.get $b) (local.get $stride)))
  (local.set $a (f32x4.add (local.get $a) (f32x4.mul (f32x4.sub (call $gather (local.get $p) (local.get $r) (local.get $g) (local.get $b) (i32.const 4)) (local.get $a)) (local.get $fx))))
  (local.set $c (f32x4.add (local.get $c) (f32x4.mul (f32x4.sub (call $gather (local.get $p) (local.get $r) (local.get $g) (local.get $b) (i32.add (local.get $stride) (i32.const 4))) (local.get $c)) (local.get $fx))))
  (f32x4.add (local.get $a) (f32x4.mul (f32x4.sub (local.get $c) (local.get $a)) (local.get $fy))))
 (func $fractions3 (param $p i32) (result v128)
  (f32x4.mul (f32x4.convert_i32x4_u (i32x4.extend_low_i16x8_u (v128.load64_zero (local.get $p)))) (f32x4.splat (f32.const 0.000015259021896696422))))
 (func $halo (param $out i32) (param $warp i32) (param $wide i32) (param $core i32) (param $width i32) (param $bloom f32) (param $x0 i32) (param $x1 i32) (param $y0 i32) (param $y1 i32)
  (local $x i32) (local $y i32) (local $i i32) (local $color v128) (local $wideColor v128) (local $coverage v128)
  (local.set $y (local.get $y0))
  (loop $rows
   (local.set $x (local.get $x0))
   (loop $columns
    (local.set $i (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)))
    (local.set $color (v128.load (i32.add (local.get $core) (i32.mul (local.get $i) (i32.const 12)))))
    (if (f32.gt (local.get $bloom) (f32.const 0)) (then
     (local.set $coverage (f32x4.splat (f32.mul (f32.convert_i32_u (i32.load8_u (i32.add (local.get $warp) (i32.add (i32.mul (local.get $i) (i32.const 4)) (i32.const 3))))) (f32.mul (global.get $wideCut) (f32.const 0.00392156862745098)))))
     (local.set $wideColor (f32x4.mul (f32x4.max (f32x4.splat (f32.const 0)) (f32x4.sub (f32x4.mul (call $pixel (i32.add (local.get $wide) (i32.mul (local.get $i) (i32.const 4)))) (f32x4.splat (f32.mul (global.get $wideGain) (f32.const 0.00392156862745098)))) (local.get $coverage))) (f32x4.splat (local.get $bloom))))
     (local.set $color (f32x4.sub (f32x4.splat (f32.const 1)) (f32x4.mul (f32x4.sub (f32x4.splat (f32.const 1)) (local.get $color)) (f32x4.sub (f32x4.splat (f32.const 1)) (local.get $wideColor)))))
    ))
    (i32.store (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 4))) (i32.or (i32x4.extract_lane 0 (call $bytes (f32x4.mul (local.get $color) (f32x4.splat (f32.const 255))))) (i32.const -16777216)))
    (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $columns (i32.lt_u (local.get $x) (local.get $x1)))
   )
