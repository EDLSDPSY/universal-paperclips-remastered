 )

 (func (export "reduce4") (param $source i32) (param $out i32) (param $mask i32) (param $width i32) (param $height i32)
  (local $lw i32) (local $lh i32) (local $cols i32) (local $x i32) (local $y i32) (local $dx i32) (local $dy i32) (local $c i32) (local $px i32) (local $py i32) (local $base i32) (local $at i32)
  (local $sum v128) (local $row v128) (local $rgba v128)
  (local.set $lw (i32.div_u (i32.add (local.get $width) (i32.const 3)) (i32.const 4)))
  (local.set $lh (i32.div_u (i32.add (local.get $height) (i32.const 3)) (i32.const 4)))
  (local.set $cols (i32.div_u (i32.add (local.get $lw) (i32.const 7)) (i32.const 8)))
  (loop $rows
   (local.set $x (i32.const 0))
   (loop $columns
    (if (i32.load8_u (i32.add (local.get $mask) (i32.add (i32.mul (i32.div_u (local.get $y) (i32.const 8)) (local.get $cols)) (i32.div_u (local.get $x) (i32.const 8))))) (then
     (local.set $at (i32.add (local.get $out) (i32.mul (i32.add (i32.mul (local.get $y) (local.get $lw)) (local.get $x)) (i32.const 4))))
     (local.set $sum (v128.const i32x4 0 0 0 0))
     (local.set $dy (i32.const 0))
     (loop $sampleRows
      (local.set $py (call $tileEnd (i32.add (i32.mul (local.get $y) (i32.const 4)) (local.get $dy)) (i32.sub (local.get $height) (i32.const 1))))
      (local.set $base (i32.add (local.get $source) (i32.mul (i32.add (i32.mul (local.get $py) (local.get $width)) (i32.mul (local.get $x) (i32.const 4))) (i32.const 4))))
      (if (i32.lt_u (i32.add (i32.mul (local.get $x) (i32.const 4)) (i32.const 3)) (local.get $width)) (then
       (local.set $row (v128.load (local.get $base)))
       (local.set $row (i16x8.add (i16x8.extend_low_i8x16_u (local.get $row)) (i16x8.extend_high_i8x16_u (local.get $row))))
       (local.set $rgba (f32x4.convert_i32x4_u (i32x4.add (i32x4.extend_low_i16x8_u (local.get $row)) (i32x4.extend_high_i16x8_u (local.get $row)))))
      ) (else
       (local.set $rgba (v128.const i32x4 0 0 0 0)) (local.set $dx (i32.const 0))
       (loop $edgeColumns
        (local.set $px (call $tileEnd (i32.add (i32.mul (local.get $x) (i32.const 4)) (local.get $dx)) (i32.sub (local.get $width) (i32.const 1))))
        (local.set $rgba (f32x4.add (local.get $rgba) (call $pixel (i32.add (local.get $source) (i32.mul (i32.add (i32.mul (local.get $py) (local.get $width)) (local.get $px)) (i32.const 4))))))
        (local.set $dx (i32.add (local.get $dx) (i32.const 1))) (br_if $edgeColumns (i32.lt_u (local.get $dx) (i32.const 4)))
       )
      ))
      (local.set $sum (f32x4.add (local.get $sum) (local.get $rgba)))
      (local.set $dy (i32.add (local.get $dy) (i32.const 1))) (br_if $sampleRows (i32.lt_u (local.get $dy) (i32.const 4)))
     )
     (i32.store (local.get $at) (i32x4.extract_lane 0 (call $bytes (f32x4.mul (local.get $sum) (f32x4.splat (f32.const 0.0625))))))
    ))
    (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $columns (i32.lt_u (local.get $x) (local.get $lw)))
   )
   (local.set $y (i32.add (local.get $y) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $y) (local.get $lh)))
  )
 )

 (func (export "blurSingleTiles") (param $source i32) (param $out i32) (param $kernel i32) (param $minus i32) (param $plus i32) (param $last i32) (param $axis i32) (param $mask i32) (param $changed i32) (param $width i32) (param $height i32)
  (local $cols i32) (local $count i32) (local $t i32) (local $x i32) (local $y i32) (local $x0 i32) (local $x1 i32) (local $y1 i32) (local $at i32) (local $base i32) (local $position i32) (local $left i32) (local $right i32) (local $value i32) (local $c i32) (local $k i32)
  (local $sum v128)
  (local $w0 v128)
  (local $w1 v128)
  (local $w2 v128)
  (local $w3 v128)
  (local $w4 v128)
  (local $w5 v128)
  (local $w6 v128)
  (local $w7 v128)
  (local $w8 v128)
  (local.set $w0 (call $weight (i32.add (local.get $kernel) (i32.const 0))))
  (local.set $w1 (call $weight (i32.add (local.get $kernel) (i32.const 8))))
  (local.set $w2 (call $weight (i32.add (local.get $kernel) (i32.const 16))))
  (local.set $w3 (call $weight (i32.add (local.get $kernel) (i32.const 24))))
  (local.set $w4 (call $weight (i32.add (local.get $kernel) (i32.const 32))))
  (local.set $w5 (call $weight (i32.add (local.get $kernel) (i32.const 40))))
  (local.set $w6 (call $weight (i32.add (local.get $kernel) (i32.const 48))))
  (local.set $w7 (call $weight (i32.add (local.get $kernel) (i32.const 56))))
  (local.set $w8 (call $weight (i32.add (local.get $kernel) (i32.const 64))))
  (local.set $cols (i32.div_u (i32.add (local.get $width) (i32.const 7)) (i32.const 8)))
  (local.set $count (i32.mul (local.get $cols) (i32.div_u (i32.add (local.get $height) (i32.const 7)) (i32.const 8))))
  (loop $tiles
   (if (i32.load8_u (i32.add (local.get $mask) (local.get $t))) (then
    (local.set $x0 (i32.mul (i32.rem_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (local.set $x1 (call $tileEnd (i32.add (local.get $x0) (i32.const 8)) (local.get $width)))
    (local.set $y (i32.mul (i32.div_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (local.set $y1 (call $tileEnd (i32.add (local.get $y) (i32.const 8)) (local.get $height)))
    (loop $rows
     (local.set $x (local.get $x0))
     (loop $columns
      (local.set $at (i32.mul (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 4)))
      (local.set $position (i32.mul (select (local.get $y) (local.get $x) (local.get $axis)) (i32.const 36)))
      (local.set $base (i32.mul (select (local.get $x) (i32.mul (local.get $y) (local.get $width)) (local.get $axis)) (i32.const 4)))
      (local.set $sum (f32x4.mul (call $pixel (i32.add (local.get $source) (local.get $at))) (local.get $w0)))
      (if (i32.ge_u (local.get $last) (i32.const 1)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 4)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 4)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w1))))
      ))
      (if (i32.ge_u (local.get $last) (i32.const 2)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 8)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 8)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w2))))
      ))
      (if (i32.ge_u (local.get $last) (i32.const 3)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 12)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 12)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w3))))
      ))
      (if (i32.ge_u (local.get $last) (i32.const 4)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 16)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 16)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w4))))
      ))
      (if (i32.ge_u (local.get $last) (i32.const 5)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 20)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 20)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w5))))
      ))
      (if (i32.ge_u (local.get $last) (i32.const 6)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 24)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 24)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w6))))
      ))
      (if (i32.ge_u (local.get $last) (i32.const 7)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 28)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 28)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w7))))
      ))
      (if (i32.ge_u (local.get $last) (i32.const 8)) (then
       (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.const 32)))))))
       (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.const 32)))))))
       (local.set $sum (f32x4.add (local.get $sum) (f32x4.mul (f32x4.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (local.get $w8))))
      ))
      (local.set $value (i32.or (i32x4.extract_lane 0 (call $bytes (local.get $sum))) (i32.const -16777216)))
      (if (i32.ne (local.get $value) (i32.load (i32.add (local.get $out) (local.get $at)))) (then (i32.store8 (i32.add (local.get $changed) (local.get $t)) (i32.const 1))))
      (i32.store (i32.add (local.get $out) (local.get $at)) (local.get $value))
      (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $columns (i32.lt_u (local.get $x) (local.get $x1)))
     )
     (local.set $y (i32.add (local.get $y) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $y) (local.get $y1)))
    )
   ))
   (local.set $t (i32.add (local.get $t) (i32.const 1))) (br_if $tiles (i32.lt_u (local.get $t) (local.get $count)))
  )
 )
)
