     (i32.store8 (i32.add (local.get $dirty) (i32.add (i32.mul (i32.shr_u (local.get $y) (i32.const 3)) (local.get $tilesX)) (i32.shr_u (local.get $x) (i32.const 3)))) (i32.const 1))))
    (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $tail)))
