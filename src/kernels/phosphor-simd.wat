    (local.set $b (f32x4.add (local.get $b) (f32x4.mul (f32x4.sub (call $pixel (i32.add (i32.add (local.get $j) (local.get $stride)) (i32.const 4))) (local.get $b)) (local.get $fx))))
    (local.set $packed (i32.or (i32x4.extract_lane 0 (call $bytes (f32x4.add (local.get $a) (f32x4.mul (f32x4.sub (local.get $b) (local.get $a)) (local.get $fy))))) (i32.const -16777216)))
    (local.set $changed (i32.or (local.get $changed) (i32.xor (local.get $packed) (i32.load (i32.add (local.get $out) (local.get $i))))))
    (i32.store (i32.add (local.get $out) (local.get $i)) (local.get $packed))
