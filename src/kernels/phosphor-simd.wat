 (func $finish (export "finish")
  (param $out i32) (param $warp i32) (param $tight i32) (param $wide i32)
  (param $indices i32) (param $weightsX i32) (param $weightsY i32)
  (param $stride i32) (param $width i32) (param $bloom f32)
  (param $x0 i32) (param $x1 i32) (param $y0 i32) (param $y1 i32) (param $core i32) (param $rebuild i32)
  (local $x i32) (local $y i32) (local $i i32) (local $pos i32) (local $r i32) (local $g i32) (local $b i32)
  (local $fx v128) (local $fy v128) (local $color v128) (local $a v128) (local $c v128) (local $coverage v128)
  (local.set $y (local.get $y0))
  (block $endY (loop $row
   (br_if $endY (i32.ge_u (local.get $y) (local.get $y1)))
   (local.set $x (local.get $x0))
   (block $endX (loop $column
    (br_if $endX (i32.ge_u (local.get $x) (local.get $x1)))
    (local.set $i (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)))
    (local.set $pos (i32.mul (local.get $i) (i32.const 3)))
    (local.set $coverage (f32x4.splat (f32.mul (f32.convert_i32_u (i32.load8_u (i32.add (local.get $warp) (i32.add (i32.mul (local.get $i) (i32.const 4)) (i32.const 3))))) (f32.const 0.00392156862745098))))
    (if (local.get $rebuild) (then
    (local.set $r (i32.load (i32.add (local.get $indices) (i32.mul (local.get $pos) (i32.const 4)))))
    (local.set $g (i32.load (i32.add (local.get $indices) (i32.add (i32.mul (local.get $pos) (i32.const 4)) (i32.const 4)))))
    (local.set $b (i32.load (i32.add (local.get $indices) (i32.add (i32.mul (local.get $pos) (i32.const 4)) (i32.const 8)))))
    (local.set $fx (call $fractions3 (i32.add (local.get $weightsX) (i32.mul (local.get $pos) (i32.const 2)))))
    (local.set $fy (call $fractions3 (i32.add (local.get $weightsY) (i32.mul (local.get $pos) (i32.const 2)))))
    (local.set $color (f32x4.mul (call $bilinear3 (local.get $warp) (local.get $r) (local.get $g) (local.get $b) (local.get $fx) (local.get $fy) (local.get $stride)) (f32x4.splat (f32.const 0.00392156862745098))))
     (if (f32.gt (local.get $bloom) (f32.const 0)) (then
     (local.set $a (f32x4.mul (f32x4.max (f32x4.splat (f32.const 0)) (f32x4.sub (f32x4.mul (call $bilinear3 (local.get $tight) (local.get $r) (local.get $g) (local.get $b) (local.get $fx) (local.get $fy) (local.get $stride)) (f32x4.splat (f32.mul (global.get $tightGain) (f32.const 0.00392156862745098)))) (f32x4.mul (f32x4.splat (global.get $tightCut)) (local.get $coverage)))) (f32x4.splat (local.get $bloom))))
      (local.set $color (f32x4.sub (f32x4.splat (f32.const 1)) (f32x4.mul (f32x4.sub (f32x4.splat (f32.const 1)) (local.get $color)) (f32x4.sub (f32x4.splat (f32.const 1)) (local.get $a)))))
     ))
     (v128.store64_lane 0 (i32.add (local.get $core) (i32.mul (local.get $i) (i32.const 12))) (local.get $color))
     (v128.store32_lane 2 (i32.add (local.get $core) (i32.add (i32.mul (local.get $i) (i32.const 12)) (i32.const 8))) (local.get $color))
    ))
    (if (i32.eqz (local.get $rebuild)) (then (local.set $color (v128.load (i32.add (local.get $core) (i32.mul (local.get $i) (i32.const 12)))))))
    (if (f32.gt (local.get $bloom) (f32.const 0)) (then
     (local.set $c (f32x4.mul (f32x4.max (f32x4.splat (f32.const 0)) (f32x4.sub (f32x4.mul (call $pixel (i32.add (local.get $wide) (i32.mul (local.get $i) (i32.const 4)))) (f32x4.splat (f32.mul (global.get $wideGain) (f32.const 0.00392156862745098)))) (f32x4.mul (f32x4.splat (global.get $wideCut)) (local.get $coverage)))) (f32x4.splat (local.get $bloom))))
     (local.set $color (f32x4.sub (f32x4.splat (f32.const 1)) (f32x4.mul (f32x4.sub (f32x4.splat (f32.const 1)) (local.get $color)) (f32x4.sub (f32x4.splat (f32.const 1)) (local.get $c)))))
    ))
    (i32.store (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 4)))
     (i32.or (i32x4.extract_lane 0 (call $bytes (f32x4.mul (local.get $color) (f32x4.splat (f32.const 255))))) (i32.const -16777216)))
    (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $column)))
   (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $row)))
 )

 (func $tileEnd (param $a i32) (param $b i32) (result i32) (if (result i32) (i32.lt_u (local.get $a) (local.get $b)) (then (local.get $a)) (else (local.get $b))))

 (func (export "finishTiles")
  (param $out i32) (param $warp i32) (param $tight i32) (param $wide i32) (param $indices i32) (param $weightsX i32) (param $weightsY i32) (param $stride i32)
  (param $bloom f32) (param $mask i32)  (param $width i32) (param $height i32) 
  (param $core i32) (param $coreMask i32)
  (local $t i32) (local $cols i32) (local $count i32) (local $x i32) (local $y i32)
  (local.set $cols (i32.div_u (i32.add (local.get $width) (i32.const 7)) (i32.const 8)))
  (local.set $count (i32.mul (local.get $cols) (i32.div_u (i32.add (local.get $height) (i32.const 7)) (i32.const 8))))
  (loop $tiles
   (if (i32.load8_u (i32.add (local.get $mask) (local.get $t))) (then
