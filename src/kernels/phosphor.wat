(module
 (import "env" "memory" (memory 1))
 (global $tightCut (mut f32) (f32.const 0.02))
 (global $wideCut (mut f32) (f32.const 0.006))
 (global $tightGain (mut f32) (f32.const 0.55))
 (global $wideGain (mut f32) (f32.const 1.6))
 (func (export "cutoffs") (param $tight f32) (param $wide f32) (param $tg f32) (param $wg f32)
  (global.set $tightCut (local.get $tight)) (global.set $wideCut (local.get $wide)) (global.set $tightGain (local.get $tg)) (global.set $wideGain (local.get $wg)))
 (func $pixel (param $p i32) (result f64) (f64.convert_i32_u (i32.load8_u (local.get $p))))
 (func $byte (param $n f64) (result i32) (i32.trunc_f64_u (f64.nearest (f64.min (f64.const 255) (f64.max (f64.const 0) (local.get $n))))))

 (func $rounded (param $n f64) (result i32) (i32.trunc_f64_u (f64.nearest (f64.min (f64.const 255) (f64.max (f64.const 0) (local.get $n))))))
 (func $bilinear (param $p i32) (param $j i32) (param $fx f64) (param $fy f64) (param $stride i32) (result f64)
  (local $a f64) (local $b f64) (local $c f64) (local $d f64)
  (local.set $p (i32.add (local.get $p) (local.get $j)))
  (local.set $a (f64.convert_i32_u (i32.load8_u (local.get $p))))
  (local.set $b (f64.convert_i32_u (i32.load8_u (i32.add (local.get $p) (i32.const 4)))))
  (local.set $c (f64.convert_i32_u (i32.load8_u (i32.add (local.get $p) (local.get $stride)))))
  (local.set $d (f64.convert_i32_u (i32.load8_u (i32.add (i32.add (local.get $p) (local.get $stride)) (i32.const 4)))))
  (local.set $a (f64.add (local.get $a) (f64.mul (f64.sub (local.get $b) (local.get $a)) (local.get $fx))))
  (local.set $c (f64.add (local.get $c) (f64.mul (f64.sub (local.get $d) (local.get $c)) (local.get $fx))))
  (f64.add (local.get $a) (f64.mul (f64.sub (local.get $c) (local.get $a)) (local.get $fy)))
 )
 (func $finish (export "finish")
  (param $out i32) (param $warp i32) (param $tight i32) (param $wide i32)
  (param $indices i32) (param $weightsX i32) (param $weightsY i32)
  (param $stride i32) (param $width i32) (param $bloom f32)
  (param $x0 i32) (param $x1 i32) (param $y0 i32) (param $y1 i32) (param $core i32) (param $rebuild i32)
  (local $x i32) (local $y i32) (local $c i32) (local $position i32) (local $i i32) (local $j i32) (local $at i32)
  (local $fx f64) (local $fy f64) (local $color f64) (local $a f64) (local $b f64) (local $coverage f64)
  (local.set $y (local.get $y0))
  (block $endY (loop $row
   (br_if $endY (i32.ge_u (local.get $y) (local.get $y1)))
   (local.set $x (local.get $x0))
   (block $endX (loop $column
    (br_if $endX (i32.ge_u (local.get $x) (local.get $x1)))
    (local.set $i (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)))
    (local.set $position (i32.mul (local.get $i) (i32.const 3)))
    (local.set $coverage (f64.div (f64.convert_i32_u (i32.load8_u (i32.add (local.get $warp) (i32.add (i32.mul (local.get $i) (i32.const 4)) (i32.const 3))))) (f64.const 255)))
    (local.set $at (i32.add (local.get $out) (i32.mul (local.get $i) (i32.const 4))))
    (local.set $c (i32.const 0))
    (loop $channel
     (if (local.get $rebuild) (then
     (local.set $i (i32.add (local.get $position) (local.get $c)))
     (local.set $j (i32.load (i32.add (local.get $indices) (i32.mul (local.get $i) (i32.const 4)))))
     (local.set $fx (f64.div (f64.convert_i32_u (i32.load16_u (i32.add (local.get $weightsX) (i32.mul (local.get $i) (i32.const 2))))) (f64.const 65535)))
     (local.set $fy (f64.div (f64.convert_i32_u (i32.load16_u (i32.add (local.get $weightsY) (i32.mul (local.get $i) (i32.const 2))))) (f64.const 65535)))
     (local.set $color (f64.div (call $bilinear (local.get $warp) (local.get $j) (local.get $fx) (local.get $fy) (local.get $stride)) (f64.const 255)))
      (if (f32.gt (local.get $bloom) (f32.const 0)) (then
      (local.set $a (f64.mul (f64.max (f64.const 0) (f64.sub (f64.mul (call $bilinear (local.get $tight) (local.get $j) (local.get $fx) (local.get $fy) (local.get $stride)) (f64.div (f64.promote_f32 (global.get $tightGain)) (f64.const 255))) (f64.mul (f64.promote_f32 (global.get $tightCut)) (local.get $coverage)))) (f64.promote_f32 (local.get $bloom))))
       (local.set $color (f64.sub (f64.const 1) (f64.mul (f64.sub (f64.const 1) (local.get $color)) (f64.sub (f64.const 1) (local.get $a)))))
      ))
      (f32.store (i32.add (local.get $core) (i32.mul (i32.add (i32.mul (i32.div_u (i32.sub (local.get $at) (local.get $out)) (i32.const 4)) (i32.const 3)) (local.get $c)) (i32.const 4))) (f32.demote_f64 (local.get $color)))
     ))
     (local.set $color (f64.promote_f32 (f32.load (i32.add (local.get $core) (i32.mul (i32.add (i32.mul (i32.div_u (i32.sub (local.get $at) (local.get $out)) (i32.const 4)) (i32.const 3)) (local.get $c)) (i32.const 4))))))
     (if (f32.gt (local.get $bloom) (f32.const 0)) (then
      (local.set $b (f64.mul (f64.max (f64.const 0) (f64.sub (f64.mul (call $pixel (i32.add (local.get $wide) (i32.add (i32.sub (local.get $at) (local.get $out)) (local.get $c)))) (f64.div (f64.promote_f32 (global.get $wideGain)) (f64.const 255))) (f64.mul (f64.promote_f32 (global.get $wideCut)) (local.get $coverage)))) (f64.promote_f32 (local.get $bloom))))
      (local.set $color (f64.sub (f64.const 1) (f64.mul (f64.sub (f64.const 1) (local.get $color)) (f64.sub (f64.const 1) (local.get $b)))))
     ))
     (i32.store8 (i32.add (local.get $at) (local.get $c)) (call $rounded (f64.mul (local.get $color) (f64.const 255))))
     (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $channel (i32.lt_u (local.get $c) (i32.const 3))))
    (i32.store8 (i32.add (local.get $at) (i32.const 3)) (i32.const 255))
    (local.set $x (i32.add (local.get $x) (i32.const 1))) (br $column)))
   (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $row)))
 )


 (func $tileEnd (param $a i32) (param $b i32) (result i32) (if (result i32) (i32.lt_u (local.get $a) (local.get $b)) (then (local.get $a)) (else (local.get $b))))

 (func (export "finishTiles")
  (param $out i32) (param $warp i32) (param $tight i32) (param $wide i32) (param $indices i32) (param $weightsX i32) (param $weightsY i32) (param $stride i32)
  (param $bloom f32) (param $mask i32)  (param $width i32) (param $height i32) 
  (param $core i32) (param $coreMask i32)
  (local $t i32) (local $cols i32) (local $count i32) (local $x i32) (local $y i32)
  (local.set $cols (i32.div_u (i32.add (local.get $width) (i32.const 7)) (i32.const 8)))
  (local.set $count (i32.mul (local.get $cols) (i32.div_u (i32.add (local.get $height) (i32.const 7)) (i32.const 8))))
  (loop $tiles
   (if (i32.load8_u (i32.add (local.get $mask) (local.get $t))) (then
    (local.set $x (i32.mul (i32.rem_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (local.set $y (i32.mul (i32.div_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (call $finish (local.get $out) (local.get $warp) (local.get $tight) (local.get $wide) (local.get $indices) (local.get $weightsX) (local.get $weightsY) (local.get $stride) (local.get $width) (local.get $bloom) (local.get $x) (call $tileEnd (i32.add (local.get $x) (i32.const 8)) (local.get $width)) (local.get $y) (call $tileEnd (i32.add (local.get $y) (i32.const 8)) (local.get $height)) (local.get $core) (i32.load8_u (i32.add (local.get $coreMask) (local.get $t))))
   ))
   (local.set $t (i32.add (local.get $t) (i32.const 1)))
   (br_if $tiles (i32.lt_u (local.get $t) (local.get $count)))
  )
 )

 (func (export "reduce4") (param $source i32) (param $out i32) (param $mask i32) (param $width i32) (param $height i32)
  (local $lw i32) (local $lh i32) (local $cols i32) (local $x i32) (local $y i32) (local $dx i32) (local $dy i32) (local $c i32) (local $px i32) (local $py i32) (local $base i32) (local $at i32)
  (local $sum f64)
  (local.set $lw (i32.div_u (i32.add (local.get $width) (i32.const 3)) (i32.const 4)))
  (local.set $lh (i32.div_u (i32.add (local.get $height) (i32.const 3)) (i32.const 4)))
  (local.set $cols (i32.div_u (i32.add (local.get $lw) (i32.const 7)) (i32.const 8)))
  (loop $rows
   (local.set $x (i32.const 0))
   (loop $columns
    (if (i32.load8_u (i32.add (local.get $mask) (i32.add (i32.mul (i32.div_u (local.get $y) (i32.const 8)) (local.get $cols)) (i32.div_u (local.get $x) (i32.const 8))))) (then
     (local.set $at (i32.add (local.get $out) (i32.mul (i32.add (i32.mul (local.get $y) (local.get $lw)) (local.get $x)) (i32.const 4))))
     (local.set $c (i32.const 0))
     (loop $channels
      (local.set $sum (f64.const 0)) (local.set $dy (i32.const 0))
      (loop $sampleRows
       (local.set $py (call $tileEnd (i32.add (i32.mul (local.get $y) (i32.const 4)) (local.get $dy)) (i32.sub (local.get $height) (i32.const 1))))
       (local.set $dx (i32.const 0))
       (loop $sampleColumns
        (local.set $px (call $tileEnd (i32.add (i32.mul (local.get $x) (i32.const 4)) (local.get $dx)) (i32.sub (local.get $width) (i32.const 1))))
        (local.set $sum (f64.add (local.get $sum) (call $pixel (i32.add (local.get $source) (i32.add (i32.mul (i32.add (i32.mul (local.get $py) (local.get $width)) (local.get $px)) (i32.const 4)) (local.get $c))))))
        (local.set $dx (i32.add (local.get $dx) (i32.const 1))) (br_if $sampleColumns (i32.lt_u (local.get $dx) (i32.const 4)))
       )
       (local.set $dy (i32.add (local.get $dy) (i32.const 1))) (br_if $sampleRows (i32.lt_u (local.get $dy) (i32.const 4)))
      )
      (i32.store8 (i32.add (local.get $at) (local.get $c)) (call $rounded (f64.mul (local.get $sum) (f64.const 0.0625))))
      (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $channels (i32.lt_u (local.get $c) (i32.const 4)))
     )
    ))
    (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $columns (i32.lt_u (local.get $x) (local.get $lw)))
   )
   (local.set $y (i32.add (local.get $y) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $y) (local.get $lh)))
  )
 )

 (func (export "blurSingleTiles") (param $source i32) (param $out i32) (param $kernel i32) (param $minus i32) (param $plus i32) (param $last i32) (param $axis i32) (param $mask i32) (param $changed i32) (param $width i32) (param $height i32)
  (local $cols i32) (local $count i32) (local $t i32) (local $x i32) (local $y i32) (local $x0 i32) (local $x1 i32) (local $y1 i32) (local $at i32) (local $base i32) (local $position i32) (local $left i32) (local $right i32) (local $value i32) (local $c i32) (local $k i32)
  (local $sum f64)
  (local.set $cols (i32.div_u (i32.add (local.get $width) (i32.const 7)) (i32.const 8)))
  (local.set $count (i32.mul (local.get $cols) (i32.div_u (i32.add (local.get $height) (i32.const 7)) (i32.const 8))))
  (loop $tiles
   (if (i32.load8_u (i32.add (local.get $mask) (local.get $t))) (then
    (local.set $x0 (i32.mul (i32.rem_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (local.set $x1 (call $tileEnd (i32.add (local.get $x0) (i32.const 8)) (local.get $width)))
    (local.set $y (i32.mul (i32.div_u (local.get $t) (local.get $cols)) (i32.const 8)))
    (local.set $y1 (call $tileEnd (i32.add (local.get $y) (i32.const 8)) (local.get $height)))
    (loop $rows
     (local.set $x (local.get $x0))
     (loop $columns
      (local.set $at (i32.mul (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 4)))
      (local.set $position (i32.mul (select (local.get $y) (local.get $x) (local.get $axis)) (i32.const 36)))
      (local.set $base (i32.mul (select (local.get $x) (i32.mul (local.get $y) (local.get $width)) (local.get $axis)) (i32.const 4)))
      (local.set $c (i32.const 0))
      (loop $channels
       (local.set $sum (f64.mul (call $pixel (i32.add (local.get $source) (i32.add (local.get $at) (local.get $c)))) (f64.load (local.get $kernel))))
       (local.set $k (i32.const 1))
       (block $done (loop $weights
        (br_if $done (i32.gt_u (local.get $k) (local.get $last)))
        (local.set $left (i32.add (local.get $source) (i32.add (local.get $base) (i32.add (i32.load (i32.add (local.get $minus) (i32.add (local.get $position) (i32.mul (local.get $k) (i32.const 4))))) (local.get $c)))))
        (local.set $right (i32.add (local.get $source) (i32.add (local.get $base) (i32.add (i32.load (i32.add (local.get $plus) (i32.add (local.get $position) (i32.mul (local.get $k) (i32.const 4))))) (local.get $c)))))
        (local.set $sum (f64.add (local.get $sum) (f64.mul (f64.add (call $pixel (local.get $left)) (call $pixel (local.get $right))) (f64.load (i32.add (local.get $kernel) (i32.mul (local.get $k) (i32.const 8)))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $weights)
       ))
       (local.set $value (call $rounded (local.get $sum)))
       (if (i32.ne (local.get $value) (i32.load8_u (i32.add (local.get $out) (i32.add (local.get $at) (local.get $c))))) (then (i32.store8 (i32.add (local.get $changed) (local.get $t)) (i32.const 1))))
       (i32.store8 (i32.add (local.get $out) (i32.add (local.get $at) (local.get $c))) (local.get $value))
       (local.set $c (i32.add (local.get $c) (i32.const 1))) (br_if $channels (i32.lt_u (local.get $c) (i32.const 3)))
      )
      (i32.store8 (i32.add (local.get $out) (i32.add (local.get $at) (i32.const 3))) (i32.const 255))
      (local.set $x (i32.add (local.get $x) (i32.const 1))) (br_if $columns (i32.lt_u (local.get $x) (local.get $x1)))
     )
     (local.set $y (i32.add (local.get $y) (i32.const 1))) (br_if $rows (i32.lt_u (local.get $y) (local.get $y1)))
    )
   ))
   (local.set $t (i32.add (local.get $t) (i32.const 1))) (br_if $tiles (i32.lt_u (local.get $t) (local.get $count)))
  )
 )
)
